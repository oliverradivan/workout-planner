{
  "version": 2,
  "builds": [
    {
      "src": "front/vite.config.ts",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "front/dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/front/index.html"
    }
  ]
}